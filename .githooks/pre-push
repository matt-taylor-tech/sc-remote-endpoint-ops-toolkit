#!/bin/sh
# Refuse a push that changes the plugin without bumping its version.
# The logic is in pre_push.py; this wrapper finds a Python 3 that actually runs,
# because on Windows `python3` is often a Microsoft Store placeholder.
for py in python3 python "py -3"; do
  if $py -c "import sys; sys.exit(sys.version_info[0] != 3)" >/dev/null 2>&1; then
    exec $py "$(dirname "$0")/pre_push.py" "$@"
  fi
done
echo "pre-push: no Python 3 found (tried python3, python, py -3); skipping the version check." >&2
exit 0
